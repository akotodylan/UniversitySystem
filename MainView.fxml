<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.university.MainController">

    <!-- LEFT: Navigation Sidebar -->
    <left>
        <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #2c3e50; -fx-pref-width: 170px;">
            <Label text="UMS Portal" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
            <Button text="Dashboard" onAction="#showDashboard" maxWidth="Infinity"
                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Button text="Students" onAction="#showStudents" maxWidth="Infinity"
                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- CENTER: Dynamic Content Area -->
    <center>
        <StackPane fx:id="centerPane" style="-fx-padding: 20; -fx-background-color: #f8f9fa;"/>
    </center>

    <!-- BOTTOM: Status & Heartbeat Bar (LO3 & Week 7 Custom Events) -->
    <bottom>
        <HBox spacing="20" style="-fx-padding: 8 15; -fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-width: 1 0 0 0;">
            <Label fx:id="heartbeatLabel" text="System Heartbeat: Starting..." style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="eventLogLabel" text="Last Event: None" style="-fx-text-fill: #2980b9;"/>
        </HBox>
    </bottom>

</BorderPane>
